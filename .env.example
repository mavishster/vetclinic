# Скопируйте в .env и при необходимости измените. Файл .env в git не попадает.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:9000

POSTGRES_DB=vetclinic
POSTGRES_USER=vetclinic
POSTGRES_PASSWORD=vetclinic

TIME_ZONE=Asia/Bishkek

# Код узла: пишется в каждую запись и в номера документов (латиница и цифры).
NODE_ID=K1

# Перенос из VetManager (только чтение их данных).
VETMANAGER_URL=
VETMANAGER_API_KEY=
