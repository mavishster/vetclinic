# Настройки сервера клиники. Скопируйте в .env и заполните (make prod-up сделает копию сам).

# Длинная случайная строка — ключ шифрования сессий. Получить: make secret
DJANGO_SECRET_KEY=замените-на-результат-make-secret

# Пароль базы данных — придумайте сложный и сохраните в надёжном месте.
POSTGRES_DB=vetclinic
POSTGRES_USER=vetclinic
POSTGRES_PASSWORD=замените-на-сложный-пароль

# Имена и IP-адреса, по которым к серверу обращаются из клиники (через запятую).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,vetclinic-server,192.168.1.10

# Часовой пояс клиники.
TZ=Europe/Moscow
TIME_ZONE=Europe/Moscow

# Узел (для будущей синхронизации филиалов): короткий код этой клиники.
NODE_ID=K1

# Порт системы (80 — адрес без номера порта: http://vetclinic-server).
HTTP_PORT=80

# Резервные копии: папка на компьютере-сервере (лучше другой диск или сетевая папка),
# время ежедневной копии и сколько дней хранить.
BACKUP_HOST_DIR=./backups
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=30

# Продажа в минус (1 — разрешена, 0 — запрещена).
ALLOW_NEGATIVE_STOCK=1
